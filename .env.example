# Example environment variables
# Copy this file to .env and fill in your values

# Application
DEBUG=false

# OpenAI / LangChain
OPENAI_API_KEY=your-openai-api-key-here
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=false

# A2A Protocol
A2A_ENABLED=true
A2A_SECRET_KEY=change-me-in-production

# MCP Integration
MCP_ENABLED=false
MCP_ENDPOINT=

# Azure
AZURE_KEY_VAULT_NAME=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Monitoring
ENABLE_MONITORING=false
APPLICATIONINSIGHTS_CONNECTION_STRING=
